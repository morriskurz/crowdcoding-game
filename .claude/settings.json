{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "NODE_USE_ENV_PROXY=1 node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/feed-hook.mjs\" || true", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "NODE_USE_ENV_PROXY=1 node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/feed-hook.mjs\" || true", "timeout": 5 }
        ]
      }
    ]
  }
}
